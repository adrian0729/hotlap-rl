# Data: OpenF1 is CC BY-NC-SA and TUMFTM is LGPL; fetched by script, never committed.
/data/*
!/data/README.md
# Demo exports embed TUMFTM-derived track geometry: regenerate with scripts/export_demo.py.
/docs/demo/*.json
/docs/demo/*.html
# Rendered clips and frame sequences (scripts/render_demo.py) show the same geometry and are
# large: regenerate them. Stills (*.png) carry the attribution footer and are committed.
/docs/demo/*.webp
/docs/demo/*.gif
/docs/demo/*.apng
/docs/demo/*.mp4
/docs/demo/*-frames/
# The one exception (26 Nov 2026): docs/showcase/data.js is committed so the showcase page can be
# served publicly. Its geometry is under LGPL-3.0, see docs/showcase/DATA-LICENSE.md.
*.parquet
*.json.gz

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# Experiments
runs/
checkpoints/
wandb/
outputs/
*.ckpt
*.msgpack

# Agent worktrees (separate checkouts of this repo, never part of it)
.claude/worktrees/

# OS / editors
.DS_Store
.idea/
.vscode/
